    "@swc/jest": "^0.2.36",
    "@types/jest": "29.5.13",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "29.7.0",
    "prop-types": "15.8.1",
