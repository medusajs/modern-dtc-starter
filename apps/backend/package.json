    "@medusajs/dashboard": "2.23.0-preview-20261120065557",
    "@medusajs/draft-order": "2.23.0-preview-20261120065557",
    "@medusajs/framework": "2.23.0-preview-20261120065557",
    "@medusajs/icons": "2.23.0-preview-20261120065557",
    "@medusajs/js-sdk": "2.23.0-preview-20261120065557",
    "@medusajs/medusa": "2.23.0-preview-20261120065557",
    "@medusajs/types": "2.23.0-preview-20261120065557",
    "@medusajs/ui": "4.3.0-preview-20261120065557",
